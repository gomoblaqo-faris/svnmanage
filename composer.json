{
    "name": "svnmanage/svnmanage",
    "description": "svnmanage - a lightweight web administration UI for Subversion (authz, users, groups, repositories).",
    "type": "project",
    "license": "GPL-2.0-only",
    "require": {
        "php": ">=8.1"
    },
    "suggest": {
        "ext-ldap": "Required for the LDAP and Active Directory providers.",
        "ext-mbstring": "Better UTF-8 handling for file previews."
    },
    "bin": ["bin/svnmanage"],
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "SvnManage\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SvnManage\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "build": ["php scripts/build-icons.php", "npm run build:css"],
        "strings": "php scripts/extract-strings.php --missing"
    },
    "config": {
        "sort-packages": true
    }
}
